# Name and email live in ~/.gitconfig.local (not versioned), included at the end

[core]
    editor = vim
    autocrlf = input
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rebase]
    autoStash = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
    colorMoved = default
[rerere]
    enabled = true
[alias]
    st = status -sb
    sw = switch
    br = branch
    ci = commit
    amend = commit --amend --no-edit
    unstage = restore --staged
    last = log -1 HEAD --stat
    lg = log --graph --abbrev-commit --pretty=format:'%C(yellow)%h%C(reset) -%C(auto)%d%C(reset) %s %C(green)(%cr) %C(blue)<%an>%C(reset)'

[include]
    path = ~/.gitconfig.local
