#!/usr/bin/env bash
# Backs up the private data that is NOT in the dotfiles repo, so that on a new machine
# `install.sh` + `recover-private` leave it in the same state as this one.
# The archive is NOT encrypted: it contains SSH keys, passwords and credentials.
set -uo pipefail

PRIVATE_PATHS=(
  work personal docs Desktop Pictures
  .ssh .gnupg .kube .aws .config/gh
  .bashrc.local .gitconfig.local .m2/settings.xml
)
# Build output, regenerated by mvn/gradle/npm
EXCLUDES=(--exclude=target --exclude=node_modules --exclude=build --exclude=.gradle)
MANIFEST=.private-backup-manifest

fail() {
  echo "$*" >&2
  exit 1
}

existing_paths() {
  local path
  for path in "${PRIVATE_PATHS[@]}"; do
    [[ -e "$HOME/$path" ]] && echo "$path"
  done
}

show_plan() {
  local archive="$1" path
  echo "These will be copied from $HOME (without target/, node_modules/, build/, .gradle/):"
  while read -r path; do
    printf '  %8s  ~/%s\n' "$(du -sh "${EXCLUDES[@]}" "$HOME/$path" 2>/dev/null | cut -f1)" "$path"
  done
  echo
  echo "Archive: $archive"
  echo "!! WARNING: the archive is NOT ENCRYPTED. It contains your SSH keys, VPN password,"
  echo "!! cloud and cluster credentials. Keep it somewhere only you can access."
}

confirm() {
  local answer
  read -rp "Proceed? [y/N] " answer </dev/tty
  [[ "$answer" =~ ^[yY]$ ]] || { echo "Cancelled"; exit 0; }
}

# The manifest goes first in the archive so recover-private can read it quickly
create_archive() {
  local archive="$1" tmp
  shift
  tmp="$(mktemp -d)"
  printf '%s\n' "$@" >"$tmp/$MANIFEST"
  echo "Compressing, this may take several minutes..."
  tar -czf "$archive" "${EXCLUDES[@]}" -C "$tmp" "$MANIFEST" -C "$HOME" "$@"
  local status=$?
  rm -rf "$tmp"
  return $status
}

main() {
  [[ $# -eq 1 ]] || fail "Usage: backup-private <destination folder>"
  [[ -d "$1" ]] || fail "Destination folder not found: $1"
  local archive paths
  archive="$(readlink -f "$1")/private-backup-$(hostname)-$(date +%Y%m%d-%H%M).tar.gz"
  mapfile -t paths < <(existing_paths)
  printf '%s\n' "${paths[@]}" | show_plan "$archive"
  confirm
  create_archive "$archive" "${paths[@]}" || echo "!! tar reported problems (see messages above)" >&2
  echo "Done: $archive ($(du -h "$archive" | cut -f1))"
  echo "Restore on another machine with: recover-private $archive"
}

main "$@"
